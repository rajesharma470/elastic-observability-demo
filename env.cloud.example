# Elastic Cloud Configuration
# Copy this file to .env and fill in your Elastic Cloud credentials

# Elastic Cloud Endpoints
# Get these from your Elastic Cloud deployment: https://cloud.elastic.co
ELASTICSEARCH_URL=https://your-deployment.es.region.cloud.es.io:9243
KIBANA_URL=https://your-deployment.kb.region.cloud.es.io
APM_SERVER_URL=https://your-deployment.apm.region.cloud.es.io:443

# Authentication
# For Elastic Cloud, use ONE of the following options:

# Option 1: API Key (Recommended for Elastic Cloud)
# Generate from: Stack Management > Security > API Keys
# Make sure the API key has "apm" permissions
# Format: base64 encoded string (e.g., "id:secret" encoded)
ELASTIC_API_KEY=your-api-key-here

# Option 2: APM Secret Token (Alternative)
# Get from: Stack Management > APM > Settings
# Only use if you're NOT using API key
# APM_SECRET_TOKEN=your-apm-secret-token-here

# Option 3: Username/Password (Not recommended for APM)
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password-here

# APM Configuration
APM_SERVICE_NAME=checkout-api
APM_ENVIRONMENT=production

# Application Configuration
PORT=3000
API_URL=http://localhost:3000

# Synthetic Test Configuration
INTERVAL_MS=60000
